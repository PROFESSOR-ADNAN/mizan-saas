# Production Dockerfile for Mizan High-Volume Ingestion API
FROM node:22-alpine AS builder

WORKDIR /app

COPY package*.json ./
COPY packages/shared/package*.json ./packages/shared/
COPY server/package*.json ./server/
COPY worker/package*.json ./worker/
COPY web/package*.json ./web/

RUN npm ci

COPY tsconfig.json ./
COPY packages/shared ./packages/shared
COPY server ./server

RUN npm run build:shared && npm run build:server

# Runtime Stage
FROM node:22-alpine AS runner

WORKDIR /app
ENV NODE_ENV=production
ENV PORT=4001

RUN addgroup --system --gid 1001 nodejs && \
    adduser --system --uid 1001 mizan

COPY package*.json ./
COPY packages/shared/package*.json ./packages/shared/
COPY server/package*.json ./server/

RUN npm ci --omit=dev && npm cache clean --force

COPY --from=builder /app/packages/shared/dist ./packages/shared/dist
COPY --from=builder /app/server/dist ./server/dist
COPY --from=builder /app/server/openapi-ingest.yaml ./server/openapi-ingest.yaml

USER mizan

EXPOSE 4001

HEALTHCHECK --interval=10s --timeout=2s --start-period=5s --retries=3 \
  CMD wget --no-verbose --tries=1 --spider http://127.0.0.1:4001/health || exit 1

CMD ["node", "server/dist/ingest/index.js"]
