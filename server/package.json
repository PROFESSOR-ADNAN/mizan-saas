{
  "name": "@mizan/server",
  "version": "1.0.0",
  "description": "Mizan management REST API and high-volume ingestion API",
  "main": "dist/server/src/api/index.js",
  "scripts": {
    "build": "tsc",
    "dev:api": "node --watch --env-file=../.env dist/server/src/api/index.js",
    "dev:ingest": "node --watch --env-file=../.env dist/server/src/ingest/index.js",
    "test": "node --test dist/tests/unit/*.test.js 2>/dev/null || echo 'Server tests placeholder'",
    "test:isolation": "node dist/tests/isolation/tenant-isolation.test.js",
    "test:property": "node dist/tests/property/rollups-property.test.js",
    "test:billing": "node dist/tests/billing/scenarios.test.js",
    "seed": "node dist/server/src/scripts/seed.js",
    "seed:big": "node dist/server/src/scripts/seed.js --big",
    "billing:run": "node dist/server/src/scripts/billing-run.js"
  },
  "dependencies": {
    "@mizan/shared": "file:../packages/shared",
    "express": "^4.21.2",
    "mongoose": "^8.9.1",
    "ioredis": "^5.4.2",
    "zod": "^3.24.1",
    "pino": "^9.5.0",
    "pino-http": "^10.3.0",
    "jsonwebtoken": "^9.0.2",
    "bcrypt": "^5.1.1",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "helmet": "^8.0.0",
    "compression": "^1.7.5",
    "speakeasy": "^2.0.0",
    "qrcode": "^1.5.4",
    "pdfkit": "^0.15.1",
    "csv-parse": "^5.6.0",
    "nodemailer": "^6.9.16",
    "uuid": "^11.0.3",
    "archiver": "^7.0.1"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.7",
    "@types/bcrypt": "^5.0.2",
    "@types/cookie-parser": "^1.4.8",
    "@types/cors": "^2.8.17",
    "@types/compression": "^1.7.5",
    "@types/speakeasy": "^2.0.10",
    "@types/qrcode": "^1.5.5",
    "@types/pdfkit": "^0.13.7",
    "@types/nodemailer": "^6.4.17",
    "@types/archiver": "^6.0.3",
    "@types/supertest": "^6.0.2",
    "supertest": "^7.0.0",
    "fast-check": "^3.23.1",
    "typescript": "^5.7.2"
  }
}
