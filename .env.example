# ---------------------------------------------------------------------------
# MIZAN SAAS ENVIRONMENT CONFIGURATION (SAMPLE / TEST VALUES ONLY)
# ---------------------------------------------------------------------------

# Environment
NODE_ENV=development
APP_ENV=local
PORT_API=4000
PORT_INGEST=4001
WEB_PORT=5173

# Base URLs
API_BASE_URL=http://localhost:4000
INGEST_BASE_URL=http://localhost:4001
WEB_BASE_URL=http://localhost:5173

# Database & Cache
MONGODB_URI=mongodb://localhost:27017/mizan_dev?replicaSet=rs0
REDIS_URL=redis://localhost:6379

# Authentication & JWT Secrets (Use strong random strings in production)
JWT_SECRET=dev-jwt-secret-mizan-production-grade-at-least-32-chars-long
JWT_EXPIRES_IN=15m
REFRESH_TOKEN_SECRET=dev-refresh-secret-mizan-high-entropy-token-key-32
REFRESH_TOKEN_EXPIRES_IN=7d
COOKIE_DOMAIN=localhost
COOKIE_SECURE=false

# Webhook Encryption Key (32 bytes AES-256-GCM key in hex)
WEBHOOK_SIGNING_MASTER_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef

# Chapa Payment Gateway (Test Mode Keys)
CHAPA_SECRET_KEY=CHASECK_TEST-fake-chapa-secret-key-for-development
CHAPA_PUBLIC_KEY=CHAPUBK_TEST-fake-chapa-public-key-for-development
CHAPA_WEBHOOK_SECRET=fake-chapa-webhook-secret-hash
CHAPA_API_URL=https://api.chapa.co/v1

# Email Service (Mailcatcher in dev, SMTP / Resend in staging & prod)
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=test
SMTP_PASS=test
SMTP_FROM=Mizan Notifications <no-reply@mizan.et>

# System & Safety Controls
BILLING_ENABLED=true
INGEST_SAFETY_CAP=500000
MAX_BATCH_SIZE=100
MAX_BATCH_BYTES=262144
LOG_LEVEL=info
